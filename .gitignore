*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
build/
develop-eggs/
dist/
**/dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Archivos comprimidos empaquetados
*.zip
*.tar.gz
*.tgz

# Logs y trazas de ejecución
*.log
**/musicshare.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Pruebas y cobertura
.pytest_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# Terraform
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
tfplan
.terraform.lock.hcl
*.tfvars
!local.tfvars
!ci.tfvars
!production.tfvars

# Variables de entorno y secretos
.env
.env.local
.env.*.local
*.pem
*.key

# IDEs y Editores de código
.idea/
.vscode/
*.swp
*.swo
*~
.zed/

# Sistema operativo
.DS_Store
Thumbs.db
desktop.ini

# Datos locales de contenedores
floci_data/
.localstack/
